# ========================
# 偏航后端 - 环境变量配置
# 复制本文件为 .env 并填入实际值
# ========================

# 大模型 API（配置后启用真实 AI 推荐，不配置则自动回退模拟模式）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai-next.com/v1
LLM_MODEL=deepseek-v4-flash

# 跨域允许的来源（逗号分隔）。账号 Cookie 需要明确来源，不能使用 *
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8124,http://127.0.0.1:8124

# 账号数据库路径（默认 backend/pianhang.db，已加入 .gitignore）
# PIANHANG_DB=D:/path/to/pianhang.db

# 通过 HTTPS 部署时设为 1，让会话 Cookie 带上 Secure
# COOKIE_SECURE=1
