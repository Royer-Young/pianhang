# ========================
# 偏航后端 - 环境变量配置
# 复制本文件为 .env 并填入实际值
# ========================

# 运行环境：development / production
# production 时自动：
#   - COOKIE_SECURE=1（强制 HTTPS Cookie）
#   - ENABLE_DEMO_ACCOUNT=0（禁用演示账号）
#   - CORS_ORIGINS 默认收紧为空（由平台代理统一处理）
ENVIRONMENT=development

# 大模型 API（配置后启用真实 AI 推荐，不配置则自动回退模拟模式）
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai-next.com/v1
LLM_MODEL=deepseek-v4-flash

# 跨域允许的来源（逗号分隔）。账号 Cookie 需要明确来源，不能使用 *
# production 下建议留空，由 Nginx / 平台代理层统一处理
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8124,http://127.0.0.1:8124

# 账号数据库路径（默认 backend/pianhang.db，已加入 .gitignore）
# 正式部署建议指向持久卷路径，如 /data/pianhang/pianhang.db
# PIANHANG_DB=/data/pianhang/pianhang.db

# 通过 HTTPS 部署时设为 1，让会话 Cookie 带上 Secure
# ENVIRONMENT=production 时会自动强制为 1；开发环境可显式覆盖
COOKIE_SECURE=0

# 是否创建演示账号 demo / pianhang
# ENVIRONMENT=production 时默认禁用；开发环境可显式关闭
ENABLE_DEMO_ACCOUNT=1
