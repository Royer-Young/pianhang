# ========================
# 偏航后端 - 环境变量配置
# ========================

# DeepSeek 大模型 API（必需，用于真实AI能力）
# 获取地址：https://platform.deepseek.com/
LLM_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://api.openai-next.com/v1
LLM_MODEL=deepseek-v4-flash

# 前端访问地址（用于后端CORS跨域设置，逗号分隔多个地址）
# 本地开发：http://localhost:8000,http://127.0.0.1:8000
# 线上示例：https://pianhang.pages.dev,https://your-domain.com
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ========================
# 七牛云 Kodo（可选，用于上传前端资源/图床）
# 获取地址：https://portal.qiniu.com -> 右上角头像 -> 密钥管理
# ========================
# QINIU_ACCESS_KEY=your_qiniu_ak
# QINIU_SECRET_KEY=your_qiniu_sk
# QINIU_BUCKET=pianhang-web
# QINIU_REGION=z0   # z0华东 z1华北 z2华南
